{
  "name": "dsh-team-plugin",
  "version": "0.1.0",
  "description": "DSH Team 插件 — 在 DSH WebUI 中以'角色 + 团队'的视角组织多个 Agent 协作。静态双格式 Cordis 插件（DSH plugin bundle + Agent Plugins 1.0）。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "services",
    "ui",
    "cordis.patch.yml",
    "plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node scripts/verify.mjs",
    "test-install": "node scripts/test-install.mjs"
  },
  "license": "MIT",
  "keywords": [
    "deepseek",
    "dsh",
    "deepseek-harness",
    "cordis",
    "dsh-plugin",
    "plugin",
    "agent-plugins",
    "agent-skills",
    "skills",
    "dual-format",
    "team",
    "multi-agent"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-skill": "*",
    "@deepseek-ai/dsh-subagent": "*",
    "@deepseek-ai/dsh-subagent-acp": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
